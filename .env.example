# Copy to .env and fill in. Never commit .env.
YDC_API_KEY=            # You.com, https://api.you.com (Search + Contents)
PARASAIL_API_KEY=       # Parasail, https://www.saas.parasail.io/keys
PARASAIL_MODEL=parasail-glm-53-flash
PARASAIL_FAST_MODEL=parasail-deepseek-v4-flash
ONE_API_KEY=            # One, https://app.withone.ai/settings/api-keys (after `one init`, the CLI also keeps its own config)
DISCORD_CHANNEL_ID=
TEAM_HANDLE=
API_PORT=8000
WEB_PORT=3000
